{
  "name": "cipher-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 + Koa 应用层 HTTP 加密实验室",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "certs": "node scripts/certs.mjs",
    "predev": "npm run certs",
    "dev": "concurrently -k -n API,WEB -c cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "prepreview": "npm run certs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "jose": "^6.1.0",
    "koa": "^3.0.0",
    "koa-static": "^5.0.0",
    "mermaid": "^11.17.2",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.0",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.0.0",
    "@vitejs/devtools": "^0.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "code-inspector-plugin": "^2.0.9",
    "concurrently": "^9.0.0",
    "fast-glob": "^3.3.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-inspect": "^12.1.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.0.0"
  }
}
