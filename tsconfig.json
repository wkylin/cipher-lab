{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
