# 明文/密文切换默认值。两种模式均通过 HTTPS。
VITE_API_ENCRYPTED=true
# 公开的教学 token，不是生产凭证；客户端构建环境变量对用户可见。
VITE_DEMO_TOKEN=demo-token
# 服务器是否允许明文业务请求；false 可演示禁止降级。
ALLOW_PLAINTEXT=true
API_PORT=8787
# Vite dev / preview 代理日志，仅输出方法、路径、响应状态和响应头耗时。
PROXY_LOG=true
# 可选：Code Inspector 默认自动识别编辑器；也可填 code / cursor。
# CODE_EDITOR=code
